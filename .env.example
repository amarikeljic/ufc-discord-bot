# Copy this file to ".env" and fill in your values.

# --- Required ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# --- Optional ---------------------------------------------------------------
# Comma-separated guild IDs. Slash commands appear instantly in these servers.
# Leave blank to register commands globally (can take up to an hour to appear).
DEV_GUILD_IDS=

# Where the SQLite database lives.
DATABASE_PATH=ufcbot.sqlite3

# Default settings applied to a server the first time it enables syncing.
# How far ahead to create scheduled events.
DEFAULT_DAYS_AHEAD=60
# How long a scheduled event should last, in minutes.
DEFAULT_EVENT_DURATION_MINUTES=240
# Which part of the card the scheduled event starts at: "main_card" or "prelims".
DEFAULT_START_ANCHOR=main_card

# Attach event poster art to Discord scheduled events (uses TheSportsDB).
ENABLE_POSTER_ART=true

# Seconds to cache upstream API responses in memory.
CACHE_TTL_SECONDS=900

# --- Fighter stats and predictions -------------------------------------------
# Show model picks on cards and enable /ufc predict. Needs the dataset and model,
# which the bot downloads and trains on its own (or run: python train.py).
ENABLE_PREDICTIONS=true
# Where the ufcstats.com dataset CSVs and the trained model are stored.
DATA_DIR=data
MODEL_DIR=models
# How often to check upstream for new fight data, in hours. The bot checks more
# often right after a card until the data for it arrives.
STATS_REFRESH_HOURS=24

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
